# Copia este archivo a .env y completa los valores. No pongas Client Secrets aquí.
# Auth0:Domain y Auth0:Audience son obligatorios para arrancar la API.

AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.battlehub.local/profile

# Profile Service local. Dentro de Docker se usa host.docker.internal para salir al equipo.
PROFILE_BASE_URL=http://host.docker.internal:5220
