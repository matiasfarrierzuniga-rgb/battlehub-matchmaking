# Copiar a .env y completar el dominio real de Auth0. No incluir secretos ni tokens.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.battlehub.local/profile
MONGO_CONNECTION_STRING=mongodb://mongodb:27017
MONGO_DATABASE=battlehub_matchmaking
MATCHMAKING_PORT=5211
MONGO_PORT=27017
CORS_ORIGIN=http://localhost:4000
