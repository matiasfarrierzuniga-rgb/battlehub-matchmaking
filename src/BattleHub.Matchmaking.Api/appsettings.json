{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "battlehub_matchmaking"
  },
  "GameServices": {
    "Clients": {}
  },
  "Cleanup": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "HeartbeatTimeoutSeconds": 120,
    "InactivitySeconds": 300,
    "ExpirationSeconds": 7200,
    "RetentionSeconds": 600
  }
}
